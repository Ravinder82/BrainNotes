{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A calm command-deck system for an AI crew messenger — deep teal signal on warm paper and navy ink, native iOS type, quiet elevation, one accent that only fires on action and live state.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.078,
          0.102
        ],
        "hex": "#0b141a"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.357,
          0.42,
          0.451
        ],
        "hex": "#5b6b73"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.502,
          0.412
        ],
        "hex": "#008069"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.965,
          0.957,
          0.941
        ],
        "hex": "#f6f4f0"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.659,
          0.518
        ],
        "hex": "#00a884"
      }
    },
    "tertiary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.439,
          0.361
        ],
        "hex": "#00705c"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "surface-sunken": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.937,
          0.918,
          0.886
        ],
        "hex": "#efeae2"
      }
    },
    "surface-dark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.078,
          0.102
        ],
        "hex": "#0b141a"
      }
    },
    "surface-dark-raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.094,
          0.149,
          0.18
        ],
        "hex": "#18262e"
      }
    },
    "bubble-incoming": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "bubble-outgoing": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.851,
          0.992,
          0.827
        ],
        "hex": "#d9fdd3"
      }
    },
    "bubble-incoming-dark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.106,
          0.161,
          0.188
        ],
        "hex": "#1b2930"
      }
    },
    "bubble-outgoing-dark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.369,
          0.306
        ],
        "hex": "#0b5e4e"
      }
    },
    "composer-field": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "composer-field-dark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.133,
          0.2,
          0.235
        ],
        "hex": "#22333c"
      }
    },
    "live": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.145,
          0.827,
          0.4
        ],
        "hex": "#25d366"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.753,
          0.224,
          0.169
        ],
        "hex": "#c0392b"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system",
        "fontSize": {
          "value": 1.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system",
        "fontSize": {
          "value": 1.125,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system",
        "fontSize": {
          "value": 0.9375,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    },
    "overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system",
        "fontSize": {
          "value": 0.6875,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    },
    "meta": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system",
        "fontSize": {
          "value": 0.6875,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    }
  }
}
